---
import Icon from './Icon.astro';
---

<section class="relative w-full overflow-hidden bg-[#151922] text-[#FBFAF7] lg:min-h-[720px] flex flex-col lg:block" id="hero">
  <!-- HERO IMAGE BLOCK: Stacked on top (<1024px) with rounded-b-3xl, absolute background on desktop (>=1024px) -->
  <div class="relative w-full aspect-[16/10] md:aspect-[16/9] lg:aspect-auto lg:absolute lg:inset-0 lg:z-0 overflow-hidden rounded-b-3xl lg:rounded-none">
    <picture class="w-full h-full block">
      <source
        media="(max-width: 767px)"
        type="image/avif"
        srcset="/images/hero-mobile-640.avif 640w"
        sizes="100vw"
      />
      <source
        media="(max-width: 767px)"
        type="image/webp"
        srcset="/images/hero-mobile-640.webp 640w"
        sizes="100vw"
      />
      <source
        type="image/avif"
        srcset="/images/hero-640.avif 640w, /images/hero-960.avif 960w, /images/hero-1280.avif 1280w, /images/hero-1672.avif 1672w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/hero-640.webp 640w, /images/hero-960.webp 960w, /images/hero-1280.webp 1280w, /images/hero-1672.webp 1672w"
        sizes="100vw"
      />
      <img
        src="/images/hero-1672.jpg"
        srcset="/images/hero-640.jpg 640w, /images/hero-960.jpg 960w, /images/hero-1280.jpg 1280w, /images/hero-1672.jpg 1672w"
        sizes="100vw"
        width="1672"
        height="941"
        alt="Cadastral map, legal volumes, balance of justice and farmland"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-image w-full h-full object-cover object-[58%_50%] sm:object-[60%_50%] lg:object-center select-none"
      />
    </picture>

    <!-- Soft fade where the image meets the ink background on mobile/tablet -->
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#151922] to-transparent pointer-events-none lg:hidden" aria-hidden="true"></div>

    <!-- Desktop feathered left wash: active only >=1024px -->
    <div class="hero-scrim hidden lg:block absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  </div>

  <!-- HERO CONTENT: Top-aligned, sits on Ink #151922 below photo on mobile/tablet, overlays photo on desktop -->
  <div class="hero-content relative z-10 max-w-[1440px] w-full mx-auto px-6 md:px-10 lg:px-16 pt-8 pb-12 lg:pt-10 lg:pb-16 bg-[#151922] lg:bg-transparent">
    <div class="hero-panel max-w-3xl lg:max-w-[560px] xl:max-w-[640px] 2xl:max-w-[680px] space-y-5 lg:space-y-6">
      <div class="reveal-item stagger-1 inline-flex items-center gap-2.5 px-4 py-1.5 bg-[#151922]/80 border border-[#A98A50]/90 rounded-full shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#A98A50]"></span>
        <span class="hero-copy-shadow text-[11px] font-bold text-[#EDE8DD] uppercase tracking-widest">LEGAL SERVICES</span>
      </div>

      <h1 class="hero-copy-shadow reveal-item stagger-2 text-4xl sm:text-5xl lg:text-[44px] xl:text-[54px] 2xl:text-[58px] font-bold text-[#FBFAF7] tracking-tight leading-[1.08] max-w-[620px]">
        End-to-end land &amp; property title verification.
      </h1>

      <p class="hero-copy-shadow reveal-item stagger-3 text-sm sm:text-base md:text-lg font-semibold text-[#EDE8DD] max-w-2xl leading-relaxed">
        Comprehensive title scrutiny across plotted developments, agricultural land, and institutional acreage. Senior Advocate RK.V &amp; Associates personally scrutinize unbroken link chains from primary revenue records (Pahanis), cross-verify Sub-Registrar books, and deliver certified written legal opinions before you purchase or develop.
      </p>

      <div class="reveal-item stagger-4 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4 pt-1">
        <a class="inline-flex items-center justify-center px-6 sm:px-7 py-3.5 bg-[#A98A50] text-[#151922] font-bold text-sm tracking-wider uppercase border border-[#A98A50] hover:bg-[#8F733E] hover:text-white rounded-full transition-colors min-h-[48px] shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FBFAF7]" href="#contact">
          Request a consultation<Icon name="arrow_forward" size={18} class="ml-2" />
        </a>
        <a class="inline-flex items-center justify-center px-6 sm:px-7 py-3.5 bg-[#151922]/75 text-[#FBFAF7] font-semibold text-sm tracking-wider uppercase border border-[#EDE8DD]/60 hover:bg-[#151922] hover:text-white rounded-full transition-colors min-h-[48px] shadow-sm backdrop-blur-[2px]" href="#services">
          Our practice areas
        </a>
      </div>

      <div class="reveal-item stagger-5 grid grid-cols-3 gap-3 sm:gap-6 pt-5 px-4 pb-4 rounded-2xl bg-[#151922]/60 border border-[#EDE8DD]/25 max-w-2xl mt-2 backdrop-blur-[2px] shadow-sm">
        <div>
          <span class="hero-copy-shadow text-[11px] uppercase font-bold tracking-wider text-[#D5D0C6] block">Human Scrutiny</span>
          <span class="hero-copy-shadow text-xs sm:text-sm font-semibold text-[#FBFAF7] mt-1 block leading-snug">Advocate RK.V &amp; Team</span>
        </div>
        <div>
          <span class="hero-copy-shadow text-[11px] uppercase font-bold tracking-wider text-[#D5D0C6] block">Field Verification</span>
          <span class="hero-copy-shadow text-xs sm:text-sm font-semibold text-[#FBFAF7] mt-1 block leading-snug">Revenue Archives &amp; Taluk</span>
        </div>
        <div>
          <span class="hero-copy-shadow text-[11px] uppercase font-bold tracking-wider text-[#D5D0C6] block">Certified Deliverable</span>
          <span class="hero-copy-shadow text-xs sm:text-sm font-semibold text-[#FBFAF7] mt-1 block leading-snug">Signed Written Legal Opinion</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-scrim {
    background-image:
      linear-gradient(
        90deg,
        rgba(21, 25, 34, 0.38) 0%,
        rgba(21, 25, 34, 0.30) 15%,
        rgba(21, 25, 34, 0.20) 28%,
        rgba(21, 25, 34, 0.08) 38%,
        rgba(21, 25, 34, 0) 45%
      );
  }

  .hero-copy-shadow {
    text-shadow:
      0 1px 2px rgba(10, 13, 20, 0.95),
      0 2px 8px rgba(10, 13, 20, 0.85),
      0 4px 18px rgba(10, 13, 20, 0.75),
      0 0 32px rgba(10, 13, 20, 0.55);
  }

  @media (max-width: 1023px) {
    .hero-copy-shadow {
      text-shadow:
        0 1px 2px rgba(10, 13, 20, 0.95),
        0 2px 8px rgba(10, 13, 20, 0.88),
        0 4px 20px rgba(10, 13, 20, 0.78),
        0 0 36px rgba(10, 13, 20, 0.60);
    }
  }
</style>
