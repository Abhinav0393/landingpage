---
import { approvedReviews, clientReviews, sampleReviews } from '../data/reviews';
import { siteEnv } from '../lib/site-env';

const isProduction = siteEnv === 'production';

if (isProduction) {
  if (sampleReviews.length > 0) {
    throw new Error(
      `RIVORA production build blocked: ${sampleReviews.length} sample review(s) are present (${sampleReviews
        .map((review) => review.id)
        .join(', ')}). Sample reviews are preview-only. Replace src/data/reviews.ts with approved client reviews (sample:false, approved:true) before building for production.`
    );
  }

  const unapproved = clientReviews.filter((review) => !review.approved);
  if (unapproved.length > 0) {
    throw new Error(
      `RIVORA production build blocked: ${unapproved.length} review(s) lack written approval (${unapproved
        .map((review) => review.id)
        .join(', ')}). Set approved:true only after written client approval.`
    );
  }

  if (approvedReviews.length === 0) {
    throw new Error(
      'RIVORA production build blocked: zero approved client reviews. Add at least one review with approved:true and sample:false before building for production.'
    );
  }
}

const visibleReviews = isProduction
  ? approvedReviews
  : clientReviews.filter((review) => review.approved || review.sample);
const showSampleNote = !isProduction && visibleReviews.some((review) => review.sample);
const reviewSets = [visibleReviews, visibleReviews];
---

<section class="w-full bg-[#F2EEE7] py-20 lg:py-24 border-t border-[#E4DED3] overflow-hidden" id="reviews">
  <div class="reveal-item max-w-[1440px] mx-auto px-6 md:px-10 lg:px-16 mb-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="text-xs uppercase font-bold tracking-widest text-[#77592A] block mb-2">Testimonials &amp; Credentials</span>
        <h2 class="text-3xl lg:text-4xl font-semibold text-[#181c24] tracking-tight text-balance">Client reviews</h2>
        <p class="text-base text-[#45474b] mt-2 max-w-2xl">What property owners, investors, and developers say about working with RK.V and the RIVORA team.</p>
      </div>

      <button
        type="button"
        data-review-pause
        aria-pressed="false"
        aria-label="Pause review carousel"
        class="review-pause-btn inline-flex min-h-[44px] shrink-0 items-center gap-2 self-start rounded-full border border-[#D8D0C2] bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#45474b] transition-colors hover:border-[#A98A50] hover:text-[#151922] sm:self-auto"
      >
        <svg class="review-pause-icon h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <rect x="3" y="2" width="3.5" height="12" rx="1"></rect>
          <rect x="9.5" y="2" width="3.5" height="12" rx="1"></rect>
        </svg>
        <svg class="review-play-icon h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M4 2.4v11.2L13 8 4 2.4Z"></path>
        </svg>
        <span data-pause-label>Pause</span>
      </button>
    </div>

    {showSampleNote && (
      <p
        data-sample-note
        class="mt-6 max-w-3xl rounded-r-2xl border-l-2 border-[#A98A50] bg-[#FBFAF7] px-4 py-3 text-sm leading-relaxed text-[#45474b]"
      >
        Sample reviews shown for design preview. These will be replaced with approved client reviews before launch.
      </p>
    )}
  </div>

  <div
    class="testimonial-marquee-container relative w-full overflow-hidden py-3 pl-6"
    data-review-marquee
    role="region"
    aria-label="Client reviews carousel"
    tabindex="0"
  >
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-28 bg-gradient-to-r from-[#F2EEE7] to-transparent z-20"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-28 bg-gradient-to-l from-[#F2EEE7] to-transparent z-20"></div>

    <div class="testimonial-marquee-track flex items-stretch">
      {reviewSets.map((set, setIndex) => (
        <div
          class="flex items-stretch gap-6 pr-6"
          data-review-set
          data-review-clone={setIndex === 1 ? 'true' : undefined}
          aria-hidden={setIndex === 1 ? 'true' : undefined}
        >
          {set.map((review) => (
            <article
              data-review-card
              class="w-[420px] max-w-[85vw] shrink-0 rounded-2xl border border-[#E4DED3] bg-white p-6 sm:p-7 flex flex-col justify-between"
            >
              <div class="space-y-4">
                {review.sample && !isProduction && (
                  <span
                    data-sample-tag
                    class="inline-flex items-center rounded-full border border-[#A98A50]/45 bg-[#FBFAF7] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#77592A]"
                  >
                    SAMPLE
                  </span>
                )}
                <p class="text-sm leading-relaxed text-[#181c24]" data-review-quote>
                  &ldquo;{review.quote}&rdquo;
                </p>
              </div>
              <div class="pt-6 mt-6 border-t border-[#E4DED3]">
                <p class="text-sm font-semibold text-[#181c24]" data-review-name>{review.name}</p>
                <span class="text-sm text-[#5C6370] block mt-0.5" data-review-role>{review.role}</span>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const marquee = document.querySelector<HTMLElement>('[data-review-marquee]');
  const pauseButton = document.querySelector<HTMLButtonElement>('[data-review-pause]');
  const pauseLabel = document.querySelector<HTMLElement>('[data-pause-label]');

  if (marquee && pauseButton && pauseLabel) {
    pauseButton.addEventListener('click', () => {
      const isPaused = marquee.classList.toggle('is-paused');
      pauseButton.setAttribute('aria-pressed', String(isPaused));
      pauseButton.setAttribute(
        'aria-label',
        isPaused ? 'Play review carousel' : 'Pause review carousel'
      );
      pauseLabel.textContent = isPaused ? 'Play' : 'Pause';
    });
  }
</script>
