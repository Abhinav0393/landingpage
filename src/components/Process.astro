---
import Icon from './Icon.astro';

const stages = [
  {
    num: '01',
    icon: 'assignment',
    title: 'Consultation',
    copy: 'Direct discussion with counsel: parcel identifiers, survey numbers, transaction structure, and verification objectives.',
    deliverable: 'Scope Document',
    featured: false,
  },
  {
    num: '02',
    icon: 'folder_open',
    title: 'Documents',
    copy: 'Physical collation of certified link deeds, historical Pahanis, ECs, village maps, and layout approvals from taluk archives.',
    deliverable: 'Dossier Collation',
    featured: false,
  },
  {
    num: '03',
    icon: 'manage_search',
    title: 'Scrutiny',
    copy: 'In-depth legal examination, Section 22-A prohibited register inspection, civil court indices, and master plan zoning checks.',
    deliverable: 'Legal Analysis',
    featured: true,
  },
  {
    num: '04',
    icon: 'gavel',
    title: 'Written Opinion',
    copy: "Delivery of comprehensive, reasoned written title scrutiny report and risk matrix bearing counsel's seal and signature.",
    deliverable: 'Reasoned Opinion',
    featured: false,
  },
  {
    num: '05',
    icon: 'verified',
    title: 'Transaction Support',
    copy: 'Practical advice on defect remediation, drafting protective deed covenants, Sub-Registrar guidance, and closing.',
    deliverable: 'Closing Support',
    featured: false,
  },
] as const;
---

<section class="w-full bg-[#F2EEE7] py-20 lg:py-24 border-t border-[#E4DED3]" id="process">
  <div class="max-w-[1440px] mx-auto px-6 md:px-10 lg:px-16">
    <div class="reveal-item max-w-3xl mb-10 lg:mb-12">
      <span class="text-xs uppercase font-bold tracking-widest text-[#77592A] block mb-2">Protocol &amp; Execution</span>
      <h2 class="text-3xl lg:text-4xl font-semibold text-[#181c24] tracking-tight">How our advocates examine your property</h2>
      <p class="text-base text-[#45474b] mt-3 text-pretty">A methodical, five-stage legal scrutiny pipeline handled directly by senior practitioners.</p>
    </div>

    <!-- CRISP PROCESS PATH: aligns with the five-stage grid on wide screens -->
    <div class="reveal-item stagger-1 hidden xl:block mb-8" aria-hidden="true">
      <div class="relative h-7">
        <div
          class="absolute top-1/2 h-px -translate-y-1/2 bg-[#D8D1C4]"
          style="left: calc((100% - 6rem) / 10); right: calc((100% - 6rem) / 10);"
        ></div>
        <div
          class="absolute top-1/2 h-[2px] -translate-y-1/2 bg-[#A98A50]"
          style="left: calc((100% - 6rem) / 10); width: calc(50% - (100% - 6rem) / 10);"
        ></div>
        <div class="relative grid h-7 grid-cols-5 gap-6 items-center">
          {stages.map((stage) => (
            <span
              class={`justify-self-center rounded-full ${
                stage.featured
                  ? 'w-5 h-5 bg-[#A98A50] border-2 border-[#151922] shadow-[inset_0_0_0_4px_#F2EEE7]'
                  : 'w-3.5 h-3.5 bg-[#151922] border-2 border-[#A98A50]'
              }`}
            ></span>
          ))}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-5 gap-6">
      {stages.map((stage, index) => (
        <div
          class={`reveal-item stagger-${index + 1} group flex flex-col justify-between rounded-2xl border bg-white p-6 xl:p-7 transition-colors duration-300 hover:bg-[#151922] hover:border-[#A98A50] ${
            stage.featured ? 'border-[#A98A50]' : 'border-[#E4DED3]'
          }`}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold tracking-wider text-[#77592A] group-hover:text-[#A98A50] transition-colors">
                STAGE {stage.num}
              </span>
              <Icon
                name={stage.icon}
                size={20}
                class="text-[#5C6370] group-hover:text-[#A98A50] transition-colors"
              />
            </div>
            <h3 class="text-lg font-semibold text-[#181c24] group-hover:text-[#FBFAF7] mb-2 transition-colors">
              {stage.title}
            </h3>
            <p class="text-sm text-[#45474b] group-hover:text-[#EDE8DD] leading-relaxed transition-colors">
              {stage.copy}
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-[#E4DED3] group-hover:border-white/20 transition-colors">
            <span class="text-xs font-bold uppercase tracking-wider text-[#5C6370] group-hover:text-[#A0A5B2] block">
              Deliverable
            </span>
            <span class="text-sm font-semibold text-[#181c24] group-hover:text-[#FBFAF7] transition-colors">
              {stage.deliverable}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
