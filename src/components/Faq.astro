---
import Icon from './Icon.astro';

const faqs = [
  {
    num: "01",
    q: "What documents are required for a property title verification?",
    a: "Essential documents include the original link documents tracing ownership for at least 30 years, current and historical Pahanis (ROR), Encumbrance Certificates (EC Form 15 and Form 16), revenue mutation registers, village layout or Tippani survey maps, tax assessment receipts, and layout approvals from the statutory planning authority."
  },
  {
    num: "02",
    q: "What is Section 22-A and why is it critical in land transactions?",
    a: "Section 22-A of the Registration Act mandates a prohibition list of properties that cannot be registered. This includes government assigned lands, Wakf properties, Endowments land, acquired lands, and parcels under litigation or ceiling surplus. A property notified under Section 22-A cannot be transferred, and any transaction is void ab initio."
  },
  {
    num: "03",
    q: "How long does an end-to-end title verification report take?",
    a: "A standard 30-year verification for urban plotted properties typically takes 5 to 7 business days once certified copies are collated. Complex agricultural acquisitions, large commercial tracts, or 60-year extended searches involving revenue archives and field inspections require 10 to 14 business days."
  },
  {
    num: "04",
    q: "What is the difference between a 15-year, 30-year, and 60-year search?",
    a: "A 15-year search verifies recent transactions for resale apartments with prior verified root titles. A 30-year search is the statutory benchmark that verifies continuous, uninterrupted ownership and eliminates claims under limitation laws. A 60-year search traces ancestral land back to original Inam or grant records, critical for agricultural conversions and institutional land banking."
  },
  {
    num: "05",
    q: "Why are Pahanis (ROR) essential alongside registered sale deeds?",
    a: "A registered sale deed confirms the conveyance transaction, but Pahanis (Record of Rights) confirm sovereign revenue recognition, actual possession, nature of cultivation, tenancy rights, and mutation entries. Discrepancies between registered deeds and Pahanis are the primary genesis of title disputes."
  },
  {
    num: "06",
    q: "Can RIVORA investigate pending litigation across civil and revenue courts?",
    a: "Yes. We cross-examine jurisdictional civil courts, high courts, and revenue appellate bodies (Tahsildar, RDO, Joint Collector) for pending suits, injunctions, partition claims, or lis pendens affecting the subject property."
  }
];
---

<section class="w-full bg-[#FBFAF7] py-20 lg:py-24 border-t border-[#E4DED3]" id="faq">
  <div class="max-w-[1440px] mx-auto px-6 md:px-10 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="reveal-item stagger-1 lg:col-span-5 lg:sticky lg:top-28 space-y-6">
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white border border-[#E4DED3] mb-4 rounded-full">
            <span class="w-2 h-2 rounded-full bg-[#A98A50]"></span>
            <span class="text-[11px] uppercase tracking-widest text-[#77592A] font-bold">FAQ // LEGAL KNOWLEDGE BASE</span>
          </div>
          <h2 class="text-3xl lg:text-4xl font-semibold text-[#181c24] tracking-tight leading-tight">Frequently asked questions</h2>
          <p class="text-base text-[#45474b] mt-3 leading-relaxed">Essential legal insights into property scrutiny, statutory risks, and title defense across South India.</p>
        </div>

        <div class="pt-2">
          <a class="inline-flex items-center justify-between gap-4 px-5 py-2.5 rounded-full bg-[#151922] text-[#FBFAF7] border border-[#262C3B] hover:border-[#A98A50] hover:bg-[#262C3B] transition-colors group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A98A50] min-h-[44px]" href="#contact">
            <span class="font-medium text-xs tracking-wider uppercase text-[#FBFAF7] group-hover:text-white">Ask Us a Question</span>
            <span class="w-6 h-6 rounded-full bg-[#A98A50] flex items-center justify-center shrink-0 group-hover:bg-[#8F733E] transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-[#151922]"></span>
            </span>
          </a>
        </div>

        <div class="flex items-center gap-2.5 text-[#45474b] text-sm">
          <Icon name="verified_user" size={18} class="shrink-0 text-[#77592A]" />
          <span>All inquiries reviewed directly by Advocate RK.V &amp; Associates</span>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-4" id="faq-accordion">
        {faqs.map((item, index) => (
          <div class={`reveal-item stagger-${(index % 6) + 1} bg-white border border-[#E4DED3] rounded-2xl overflow-hidden`}>
            <button 
              type="button" 
              class="w-full p-6 text-left flex items-center justify-between gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A98A50] group min-h-[44px]"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
              id={`faq-btn-${index}`}
            >
              <div class="flex items-start md:items-center gap-3.5">
                <span class="text-[11px] font-bold text-[#77592A] bg-[#FAF9F5] px-2.5 py-1 border border-[#E4DED3] shrink-0 rounded-full">
                  {item.num}
                </span>
                <span class="text-base md:text-lg text-[#181c24] font-semibold group-hover:text-[#77592A] transition-colors">
                  {item.q}
                </span>
              </div>
              <span class="faq-indicator shrink-0 w-8 h-8 rounded-full bg-[#FAF9F5] border border-[#E4DED3] flex items-center justify-center text-[#151922] font-bold text-base group-hover:border-[#A98A50] group-hover:text-[#77592A] transition-transform duration-300" aria-hidden="true">
                +
              </span>
            </button>
            <div 
              id={`faq-answer-${index}`}
              role="region"
              aria-labelledby={`faq-btn-${index}`}
              class="hidden px-6 pb-6 pt-1 border-t border-[#E4DED3]/60 text-[#45474b] text-sm leading-relaxed bg-[#FBFAF7]"
            >
              {item.a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    const buttons = accordion.querySelectorAll('button');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const panel = document.getElementById(btn.getAttribute('aria-controls'));
        const indicator = btn.querySelector('.faq-indicator');

        // Close other panels
        buttons.forEach(otherBtn => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherPanel = document.getElementById(otherBtn.getAttribute('aria-controls'));
            const otherIndicator = otherBtn.querySelector('.faq-indicator');
            if (otherPanel) otherPanel.classList.add('hidden');
            if (otherIndicator) {
              otherIndicator.classList.remove('rotate-45');
            }
          }
        });

        if (expanded) {
          btn.setAttribute('aria-expanded', 'false');
          if (panel) panel.classList.add('hidden');
          if (indicator) {
            indicator.classList.remove('rotate-45');
          }
        } else {
          btn.setAttribute('aria-expanded', 'true');
          if (panel) panel.classList.remove('hidden');
          if (indicator) {
            indicator.classList.add('rotate-45');
          }
        }
      });
    });
  })();
</script>

