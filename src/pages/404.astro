---
import MainLayout from '../layouts/MainLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
---

<MainLayout
  title="Page not found | RIVORA"
  description="The requested page could not be found on the RIVORA website."
  noindex
  canonical={null}
>
  <main id="main-content" class="flex-grow flex items-center bg-[#151922] text-[#FBFAF7]">
    <div class="max-w-[1440px] w-full mx-auto px-6 md:px-10 lg:px-16 py-20 lg:py-28">
      <div class="max-w-2xl">
        <a class="inline-flex items-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#A98A50] rounded-2xl p-1 -ml-1" href="/" aria-label="RIVORA home">
          <Logo variant="light" height={44} class="h-10 w-auto sm:h-11 group-hover:opacity-90 transition-opacity" />
        </a>

        <div class="mt-12 flex items-center gap-4">
          <span class="text-xs font-bold uppercase tracking-[0.3em] text-[#A98A50]">404</span>
          <span class="h-px flex-1 bg-[#A98A50]/40" aria-hidden="true"></span>
        </div>

        <h1 class="mt-6 text-4xl md:text-5xl font-bold tracking-tight leading-[1.1] text-[#FBFAF7]">
          This page could not be found.
        </h1>
        <p class="mt-4 text-base md:text-lg text-[#A0A5B2] leading-relaxed text-pretty">
          The address may have changed, or the page may no longer exist. Return to the main site or contact the office directly.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-3">
          <a class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-[#A98A50] text-[#151922] font-bold text-sm tracking-wider uppercase border border-[#A98A50] hover:bg-[#8F733E] hover:text-white rounded-full transition-colors min-h-[48px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FBFAF7]" href="/">
            Return home
            <Icon name="arrow_forward" size={18} />
          </a>
          <a class="inline-flex items-center justify-center px-7 py-3.5 bg-transparent text-[#FBFAF7] font-semibold text-sm tracking-wider uppercase border border-[#EDE8DD]/50 hover:bg-[#262C3B] hover:text-white rounded-full transition-colors min-h-[48px]" href="/#contact">
            Contact the office
          </a>
        </div>

        <p class="mt-10 text-sm text-[#A0A5B2]">
          Direct practice line:
          <a class="text-[#EDE8DD] font-semibold hover:text-[#A98A50] transition-colors" href="tel:+918099888851">+91 8099888851</a>
        </p>
      </div>
    </div>
  </main>
</MainLayout>
