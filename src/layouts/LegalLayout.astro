---
import MainLayout from './MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import type { LegalDocument } from '../data/legal';
import { legalPlaceholders } from '../data/legal';
import { siteEnv } from '../lib/site-env';
import { siteUrl } from '../lib/site';

interface Props {
  document: LegalDocument;
  path: string;
}

const { document: doc, path: pagePath } = Astro.props;
const canonical = `${siteUrl}${pagePath}`;

function renderTextWithPlaceholders(text: string): string {
  return text.replace(/\{(\w+)\}/g, (match, key) => {
    const val = legalPlaceholders[key];
    if (val && val.trim() !== '') {
      return val;
    }
    return `<span class="placeholder-chip inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-300 select-all">To be confirmed</span>`;
  });
}
---

<MainLayout
  title={`${doc.title} | RIVORA Advocates & Associates`}
  description={doc.subtitle}
  canonical={canonical}
>
  <Header />

  <main class="min-h-screen bg-[#FBFAF7] text-[#181C24] py-10 sm:py-16">
    <div class="max-w-[1440px] mx-auto px-6 md:px-10 lg:px-16">
      
      <!-- Back Link -->
      <div class="max-w-[72ch] mx-auto mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#77592A] hover:text-[#181C24] transition-colors focus:outline-none focus-visible:underline"
        >
          <Icon name="arrow_forward" size={14} class="rotate-180" /> Back to home
        </a>
      </div>

      <!-- Draft notice for advocate review -->
      {!doc.approved && (
        <div class="max-w-[72ch] mx-auto mb-10 p-5 rounded-2xl border-2 border-amber-300 bg-amber-50 text-amber-950 text-sm leading-relaxed shadow-sm">
          <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-200 text-amber-900 font-bold shrink-0 mt-0.5 text-xs">!</span>
            <div>
              <p class="font-bold text-amber-900 uppercase tracking-wider text-xs mb-1">
                Draft for Advocate Review
              </p>
              <p class="text-xs sm:text-sm text-amber-900/90 leading-relaxed">
                This document is a preliminary draft prepared for legal counsel review and does not constitute formal legal advice. It contains unresolved placeholders marked with <span class="font-semibold bg-amber-200/80 px-1 rounded">To be confirmed</span> that must be finalized and approved in writing prior to production publication.
              </p>
            </div>
          </div>
        </div>
      )}

      <!-- Legal Document Content Container (~72ch readable width) -->
      <article class="max-w-[72ch] mx-auto bg-white border border-[#E4DED3] rounded-3xl p-8 sm:p-12 md:p-16 shadow-sm space-y-10 legal-article">
        
        <!-- Header -->
        <header class="border-b border-[#E4DED3] pb-8 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF9F5] border border-[#A98A50]/60 text-[11px] font-bold uppercase tracking-widest text-[#77592A]">
            Legal Document
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#181C24] leading-tight">
            {doc.title}
          </h1>
          <p class="text-sm sm:text-base text-[#5C6370] leading-relaxed">
            {doc.subtitle}
          </p>
          <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-[#777B84] pt-2">
            <span>
              <strong>Effective date:</strong>{' '}
              {doc.effectiveDate ? (
                doc.effectiveDate
              ) : (
                <span class="placeholder-chip inline-flex items-center px-1.5 py-0.2 rounded text-[11px] font-semibold bg-amber-100 text-amber-900 border border-amber-300">
                  To be confirmed
                </span>
              )}
            </span>
            <span>
              <strong>Last updated:</strong> {doc.lastUpdated}
            </span>
          </div>
        </header>

        <!-- Table of Contents -->
        <nav class="p-6 rounded-2xl bg-[#FAF9F5] border border-[#E4DED3] space-y-3 print:hidden" aria-label="Table of Contents">
          <h2 class="text-xs font-bold uppercase tracking-widest text-[#77592A]">
            Table of Contents
          </h2>
          <ol class="grid sm:grid-cols-2 gap-x-4 gap-y-2 text-xs sm:text-[13px] text-[#45474B]">
            {doc.sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="hover:text-[#A98A50] hover:underline transition-colors block py-0.5"
                >
                  <span class="font-semibold text-[#181C24]">{section.number}.</span> {section.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <!-- Sections -->
        <div class="space-y-10 text-sm sm:text-base leading-relaxed text-[#353945]">
          {doc.sections.map((section) => (
            <section id={section.id} class="scroll-mt-28 space-y-4 pt-4 border-t border-[#F2EEE7] first:border-0 first:pt-0">
              <h2 class="text-xl sm:text-2xl font-bold text-[#181C24] tracking-tight">
                <span class="text-[#77592A] font-semibold mr-1.5">{section.number}.</span>
                {section.title}
              </h2>
              
              <div class="space-y-3">
                {section.content.map((paragraph) => (
                  <p set:html={renderTextWithPlaceholders(paragraph)} class="leading-relaxed" />
                ))}
              </div>

              {section.internalNote && (
                <div class="p-3.5 rounded-xl bg-amber-50/80 border border-amber-200 text-xs text-amber-900 leading-normal print:hidden">
                  <span class="font-bold uppercase tracking-wider block mb-0.5 text-[10px] text-amber-800">
                    Internal Advocate Note:
                  </span>
                  {section.internalNote}
                </div>
              )}
            </section>
          ))}
        </div>

        <!-- Document Footer Note -->
        <footer class="pt-8 border-t border-[#E4DED3] text-xs text-[#777B84] space-y-2">
          <p>
            RIVORA Advocates &amp; Associates. This electronic document is published for client informational purposes and compliance with applicable legal and professional practice standards.
          </p>
          <p>
            For verified written legal opinions regarding specific survey numbers and registered titles, please consult our office directly.
          </p>
        </footer>

      </article>

    </div>
  </main>

  <Footer />
</MainLayout>

<style>
  @media print {
    :global(header), :global(footer), .print\:hidden, nav, a[href="/"] {
      display: none !important;
    }
    main {
      padding: 0 !important;
      background: white !important;
    }
    article {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      max-width: 100% !important;
    }
  }
</style>

