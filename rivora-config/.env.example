# RIVORA contact endpoint configuration
#
# Copy this file to `.env` in the same `rivora-config/` directory and fill in
# the real values on the server. Never commit `.env`.
#
# This directory must sit OUTSIDE the public web root.

# production | local
# Use `local` together with CONTACT_DRY_RUN=1 only on a development machine.
APP_ENV=production
CONTACT_DRY_RUN=0

# SMTP mailbox used to deliver consultation requests.
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, usually port 587) | ssl (usually port 465) | none
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=
SMTP_PASS=

# Envelope sender. Use an address on the same domain as the SMTP mailbox so
# SPF/DKIM alignment is preserved. Reply-To is set to the visitor automatically.
MAIL_FROM=
MAIL_FROM_NAME=RIVORA Website

# Destination inbox for consultation requests.
MAIL_TO=
MAIL_TO_NAME=RIVORA Chambers
